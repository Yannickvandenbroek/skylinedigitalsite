{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/es",
      "destination": "https://www.skylinedigital.es/",
      "permanent": true
    },
    {
      "source": "/es/aanvraag",
      "destination": "https://www.skylinedigital.es/solicitud",
      "permanent": true
    },
    {
      "source": "/es/ai-content",
      "destination": "https://www.skylinedigital.es/contenido-ia",
      "permanent": true
    },
    {
      "source": "/es/contact",
      "destination": "https://www.skylinedigital.es/contacto",
      "permanent": true
    },
    {
      "source": "/es/drone-video",
      "destination": "https://www.skylinedigital.es/video-y-drones",
      "permanent": true
    },
    {
      "source": "/es/over-ons",
      "destination": "https://www.skylinedigital.es/sobre-nosotros",
      "permanent": true
    },
    {
      "source": "/es/portfolio",
      "destination": "https://www.skylinedigital.es/portafolio",
      "permanent": true
    },
    {
      "source": "/es/pricing",
      "destination": "https://www.skylinedigital.es/precios",
      "permanent": true
    },
    {
      "source": "/es/social-media",
      "destination": "https://www.skylinedigital.es/redes-sociales",
      "permanent": true
    },
    {
      "source": "/es/video",
      "destination": "https://www.skylinedigital.es/video",
      "permanent": true
    },
    {
      "source": "/es/website-seo",
      "destination": "https://www.skylinedigital.es/diseno-web-y-seo",
      "permanent": true
    },
    {
      "source": "/es/werk-bodyscan",
      "destination": "https://www.skylinedigital.es/proyecto-bodyscan",
      "permanent": true
    },
    {
      "source": "/es/werk-carslease",
      "destination": "https://www.skylinedigital.es/proyecto-carslease",
      "permanent": true
    },
    {
      "source": "/es/werk-dejonge",
      "destination": "https://www.skylinedigital.es/proyecto-dejonge",
      "permanent": true
    },
    {
      "source": "/es/werk-dekgro",
      "destination": "https://www.skylinedigital.es/proyecto-dekgro",
      "permanent": true
    },
    {
      "source": "/es/werk-echtgrieks",
      "destination": "https://www.skylinedigital.es/proyecto-echtgrieks",
      "permanent": true
    },
    {
      "source": "/es/werk-elektropost",
      "destination": "https://www.skylinedigital.es/proyecto-elektropost",
      "permanent": true
    },
    {
      "source": "/es/werk-lassie",
      "destination": "https://www.skylinedigital.es/proyecto-lassie",
      "permanent": true
    },
    {
      "source": "/es/werk-lillis",
      "destination": "https://www.skylinedigital.es/proyecto-lillis",
      "permanent": true
    },
    {
      "source": "/es/werk-palmyra",
      "destination": "https://www.skylinedigital.es/proyecto-palmyra",
      "permanent": true
    },
    {
      "source": "/es/:path*",
      "destination": "https://www.skylinedigital.es/",
      "permanent": true
    },
    {
      "source": "/content/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tools/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/i18n/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/.claude/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/es-site/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.)?skylinedigital\\.es"
        }
      ],
      "destination": "https://www.skylinedigital.nl/es",
      "permanent": true
    },
    {
      "source": "/:path((?!es(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.)?skylinedigital\\.es"
        }
      ],
      "destination": "https://www.skylinedigital.nl/es/:path",
      "permanent": true
    },
    {
      "source": "/:path(es(?:/.*)?)",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.)?skylinedigital\\.es"
        }
      ],
      "destination": "https://www.skylinedigital.nl/:path",
      "permanent": true
    },
    {
      "source": "/kennisbank",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/kennisbank/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/frames/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}